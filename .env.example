# AmarDNS Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.

# Server Network Ports (Use 8080 & 8053 for unprivileged dev, or 443 & 853 for production)
PORT=8080
DOT_PORT=8053
# Bind host: "::" enables dual-stack IPv4 + IPv6 (recommended for mobile/Android Private DNS), or "0.0.0.0" for IPv4-only
HOST=::

# TLS Configuration: Set USE_TLS=true to load SSL certs from certs/cert.pem and certs/key.pem
USE_TLS=false
# SSL_CERT=./certs/cert.pem
# SSL_KEY=./certs/key.pem

# Persistent Storage Database (PulseDB WAL path)
DB_PATH=./data/amardns.wal

# Logging Level: "warn" (recommended for production - only essential errors/warnings), "error", "info", "debug", "silent"
LOG_LEVEL=warn

# Background cron schedule for periodic maintenance & compaction
CRON_SCHEDULE="*/5 * * * *"

# Required: 3-50 character master key for dashboard and admin API access
DNS_MASTER_KEY=my-super-secret-master-key-12345

# Secrets for token signing (HMAC) and cache hashing
DNS_TOKEN_SECRET=replace-with-a-long-random-token-secret
DNS_CACHE_SECRET=replace-with-a-long-random-cache-secret
DNS_WORKER_NAME=amardns

# DNS Query Access Mode: "public" (open resolution for Android Private DNS / browsers)
# or "private" (requires masterkey or token). Can also be toggled in Web Dashboard Settings.
DNS_ACCESS_MODE=private

# Expected concurrent users. Set to "AI" to enable real-time Kalman auto-detection,
# or set to a fixed number (e.g. 1) to hardcode/pin the estimated user count.
EXPECTED_USERS=AI

# Optional: Fallback upstream DNS resolvers (queried for non-blocked domains)
UPSTREAM_BASES='["https://cloudflare-dns.com/dns-query","https://dns.google/dns-query"]'
